# Copia este archivo como ".env.local" y rellena los valores reales.
# ".env.local" nunca se sube a GitHub (está en .gitignore).

# Configuración web de tu proyecto de Firebase.
# La encuentras en: Firebase console > Configuración del proyecto > tus apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave de la API de Gemini (Google AI Studio: aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=
